# ============================================================
# Untuk DASHBOARD (dipakai browser, aman untuk terekspos)
# Ambil dari: Supabase Dashboard > Project Settings > API
# ============================================================
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ============================================================
# Untuk SCRIPT SYNC (npm run sync) — HANYA dijalankan di komputer
# kamu sendiri, JANGAN PERNAH dipakai di kode frontend/browser,
# dan JANGAN PERNAH di-commit ke git (sudah otomatis di-gitignore).
# service_role key = akses penuh, bypass semua RLS.
# Ambil dari halaman API yang sama, bagian "service_role" (klik Reveal).
# ============================================================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
