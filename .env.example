# Sumber data aplikasi: "local" (baca Excel di public/data/, default, tanpa
# perlu Supabase) atau "supabase" (baca dari database Supabase).
VITE_DATA_SOURCE=local

# Cuma dipakai kalau VITE_DATA_SOURCE=supabase. Berapa lama (menit) data
# disimpan di cache browser sebelum otomatis fetch ulang ke Supabase.
# Default 0 = TIDAK PERNAH kedaluwarsa otomatis: selalu "Cache HIT", data
# baru cuma diambil kalau kamu klik tombol refresh manual di dashboard
# (cocok kalau sync ke Supabase cuma dilakukan manual, mis. 2x sehari).
# Isi dengan angka > 0 (mis. 30) kalau mau ada auto-refresh berkala juga.
VITE_CACHE_TTL_MINUTES=0

# Dipakai oleh scripts/import-to-supabase.mjs (jalan di Node, boleh pakai service role key)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...isi-dengan-service-role-key...

# Dipakai oleh aplikasi React/Vite (browser, HARUS pakai anon key, bukan service role)
# Hanya perlu diisi kalau VITE_DATA_SOURCE=supabase.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...isi-dengan-anon-public-key...
